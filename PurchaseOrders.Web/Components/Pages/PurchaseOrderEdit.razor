@page "/purchase-orders/new"
@page "/purchase-orders/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using PurchaseOrders.Data
@using PurchaseOrders.Data.Models
@inject IDbContextFactory<PurchasingDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "New purchase order" : "Edit purchase order") - Purchase Order Manager</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(Id is null ? "New purchase order" : "Edit purchase order")</MudText>

@if (order is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Elevation="0" Class="pa-6" Style="max-width:560px;border:1px solid var(--mud-palette-divider);">
        <EditForm Model="order" OnValidSubmit="SaveAsync" FormName="po-form">
            <DataAnnotationsValidator />

            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="order.PoNumber" Label="PO number" For="() => order.PoNumber"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudSelect @bind-Value="order.SupplierId" Label="Supplier" For="() => order.SupplierId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="int" Value="0">-- choose a supplier --</MudSelectItem>
                @foreach (var supplier in suppliers)
                {
                    <MudSelectItem T="int" Value="@supplier.Id">@supplier.Name</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="order.ExpectedUtc" Label="Expected date"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudTextField @bind-Value="order.Notes" Label="Notes" For="() => order.Notes"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" Class="mb-4" />

            <div class="d-flex flex-wrap align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </MudButton>
                <MudButton Href="/purchase-orders" Variant="Variant.Text">Cancel</MudButton>

                @if (Id is not null)
                {
                    <MudSpacer />
                    @if (confirmCancel)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">Cancel this order?</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                   OnClick="CancelOrderAsync">Yes</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="@(() => confirmCancel = false)">Keep it</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                   OnClick="@(() => confirmCancel = true)">Cancel order</MudButton>
                    }
                }
            </div>
        </EditForm>
    </MudPaper>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private PurchaseOrder? order;
    private List<Supplier> suppliers = new();
    private string? errorMessage;
    private bool isSaving;
    private bool confirmCancel;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        suppliers = await db.Suppliers.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

        if (Id is null)
        {
            order = new PurchaseOrder();
            return;
        }

        order = await db.PurchaseOrders.AsNoTracking().FirstOrDefaultAsync(o => o.Id == Id);

        if (order is null)
        {
            // The id matched nothing. Send them back rather than showing a broken form.
            Nav.NavigateTo("/purchase-orders");
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var isNew = order!.Id == 0;

            if (isNew)
            {
                db.PurchaseOrders.Add(order);
            }
            else
            {
                db.PurchaseOrders.Update(order);
            }

            await db.SaveChangesAsync();

            // A new order has no lines yet, so open it straight away rather than
            // dropping the user back on a list where it looks empty.
            Nav.NavigateTo(isNew ? $"/purchase-orders/{order.Id}" : "/purchase-orders");
        }
        catch (DbUpdateException)
        {
            // The unique index rejected it. Almost always a duplicate PO number.
            errorMessage = $"PO number '{order!.PoNumber}' is already in use. Pick a different one.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CancelOrderAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var existing = await db.PurchaseOrders.FirstOrDefaultAsync(o => o.Id == Id);

        if (existing is not null)
        {
            // Hide it, do not destroy it. The list query already filters cancelled orders.
            existing.IsCancelled = true;
            await db.SaveChangesAsync();
        }

        Nav.NavigateTo("/purchase-orders");
    }
}

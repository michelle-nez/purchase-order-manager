@page "/purchase-orders/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using PurchaseOrders.Data
@using PurchaseOrders.Data.Models
@inject IDbContextFactory<PurchasingDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>@(order?.PoNumber ?? "Purchase order") - Purchase Order Manager</PageTitle>

@if (order is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <div class="d-flex flex-wrap align-center justify-space-between mb-4 gap-3">
        <div>
            <MudText Typo="Typo.h5" Style="font-family:Consolas,monospace;">@order.PoNumber</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @order.Supplier?.Name · ordered @order.OrderedUtc.ToString("d MMM yyyy")
                @if (order.ExpectedUtc is not null)
                {
                    <text> · expected @order.ExpectedUtc.Value.ToString("d MMM yyyy")</text>
                }
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Href="/purchase-orders" Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.ArrowBack">Back</MudButton>
            <MudButton Href="@($"/purchase-orders/edit/{order.Id}")" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.Edit">Edit header</MudButton>
        </div>
    </div>

    <MudPaper Elevation="0" Class="pa-4 mb-5" Style="border:1px solid var(--mud-palette-divider);">
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="4" md="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">LINES</MudText>
                <MudText Typo="Typo.h6">@order.Lines.Count</MudText>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">ORDERED</MudText>
                <MudText Typo="Typo.h6">@order.TotalOrdered</MudText>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">RECEIVED</MudText>
                <MudText Typo="Typo.h6">@order.TotalReceived</MudText>
            </MudItem>
            <MudItem xs="6" sm="4" md="3">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">TOTAL</MudText>
                <MudText Typo="Typo.h6" Color="Color.Secondary">@order.Total.ToString("C")</MudText>
            </MudItem>
            <MudItem xs="12" sm="8" md="3">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">STATUS</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ReceiptColor(order.Receipt)">
                    @ReceiptLabel(order.Receipt)
                </MudChip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">@errorMessage</MudAlert>
    }

    <MudText Typo="Typo.h6" Class="mb-2">Lines</MudText>

    @if (order.Lines.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            No lines yet. Add the first one below.
        </MudText>
    }
    else
    {
        <MudPaper Elevation="0" Class="mb-3" Style="border:1px solid var(--mud-palette-divider);">
            <MudTable Items="order.Lines" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh Style="text-align:right">Ordered</MudTh>
                    <MudTh Style="text-align:right">Unit cost</MudTh>
                    <MudTh Style="text-align:right">Line total</MudTh>
                    <MudTh Style="text-align:right">Received</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="SKU">
                        <MudText Typo="Typo.body2" Style="font-family:Consolas,monospace;">@context.Sku</MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="Ordered" Style="text-align:right">@context.QuantityOrdered</MudTd>
                    <MudTd DataLabel="Unit cost" Style="text-align:right">@context.UnitCost.ToString("C")</MudTd>
                    <MudTd DataLabel="Line total" Style="text-align:right">@context.LineTotal.ToString("C")</MudTd>
                    <MudTd DataLabel="Received" Style="text-align:right">
                        @context.QuantityReceived
                        @if (!context.IsFullyReceived)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="ml-1">
                                (@context.Outstanding out)
                            </MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="" Style="text-align:right">
                        @if (!context.IsFullyReceived)
                        {
                            <div class="d-flex align-center justify-end gap-1">
                                <MudNumericField T="int" Value="@GetReceiveQty(context)"
                                                 ValueChanged="@(v => receiveQty[context.Id] = v)"
                                                 Min="1" Max="@context.Outstanding" Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" Style="width:5.5rem;"
                                                 HideSpinButtons="true" />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="@(() => ReceiveAsync(context.Id))">Receive</MudButton>
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                               Color="Color.Error" aria-label="Remove line"
                                               OnClick="@(() => RemoveLineAsync(context.Id))" />
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-center justify-end gap-1">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                    Complete
                                </MudChip>
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                               Color="Color.Error" aria-label="Remove line"
                                               OnClick="@(() => RemoveLineAsync(context.Id))" />
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @if (order.Receipt != ReceiptState.Complete)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-5"
                       StartIcon="@Icons.Material.Outlined.DoneAll" OnClick="ReceiveAllAsync">
                Receive all outstanding
            </MudButton>
        }
    }

    <MudText Typo="Typo.h6" Class="mb-2">Add a line</MudText>

    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--mud-palette-divider);">
        <EditForm Model="newLine" OnValidSubmit="AddLineAsync" FormName="add-line">
            <DataAnnotationsValidator />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="newLine.Sku" Label="SKU" For="() => newLine.Sku"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="newLine.Description" Label="Description" For="() => newLine.Description"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField @bind-Value="newLine.QuantityOrdered" Label="Quantity"
                                     For="() => newLine.QuantityOrdered"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField @bind-Value="newLine.UnitCost" Label="Unit cost" For="() => newLine.UnitCost"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.01M" Format="F2" />
                </MudItem>
            </MudGrid>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                       StartIcon="@Icons.Material.Outlined.Add">
                Add line
            </MudButton>
        </EditForm>
    </MudPaper>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PurchaseOrder? order;
    private PurchaseOrderLine newLine = new();
    private readonly Dictionary<int, int> receiveQty = new();
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        order = await db.PurchaseOrders
            .AsNoTracking()
            .Include(o => o.Supplier)
            .Include(o => o.Lines)
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (order is null)
        {
            // The id matched nothing. Send them back rather than showing a broken page.
            Nav.NavigateTo("/purchase-orders");
        }
    }

    private int GetReceiveQty(PurchaseOrderLine line) =>
        receiveQty.TryGetValue(line.Id, out var q) ? q : line.Outstanding;

    private async Task AddLineAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        newLine.PurchaseOrderId = Id;
        db.PurchaseOrderLines.Add(newLine);
        await db.SaveChangesAsync();

        newLine = new PurchaseOrderLine();
        await LoadAsync();
    }

    private async Task ReceiveAsync(int lineId)
    {
        errorMessage = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        var line = await db.PurchaseOrderLines.FirstOrDefaultAsync(l => l.Id == lineId);

        if (line is null)
        {
            return;
        }

        var wanted = receiveQty.TryGetValue(lineId, out var q) ? q : line.Outstanding;

        if (wanted <= 0)
        {
            errorMessage = "Enter how many arrived before receiving a line.";
            return;
        }

        // Never let received run past ordered, whatever the box says.
        var accepted = Math.Min(wanted, line.Outstanding);

        if (accepted < wanted)
        {
            errorMessage = $"Only {line.Outstanding} outstanding on {line.Sku} - received that many.";
        }

        line.QuantityReceived += accepted;
        await db.SaveChangesAsync();

        receiveQty.Remove(lineId);
        await LoadAsync();
    }

    private async Task ReceiveAllAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var lines = await db.PurchaseOrderLines
            .Where(l => l.PurchaseOrderId == Id)
            .ToListAsync();

        foreach (var line in lines)
        {
            line.QuantityReceived = line.QuantityOrdered;
        }

        await db.SaveChangesAsync();
        receiveQty.Clear();
        await LoadAsync();
    }

    private async Task RemoveLineAsync(int lineId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var line = await db.PurchaseOrderLines.FirstOrDefaultAsync(l => l.Id == lineId);

        if (line is not null)
        {
            db.PurchaseOrderLines.Remove(line);
            await db.SaveChangesAsync();
        }

        await LoadAsync();
    }

    private static string ReceiptLabel(ReceiptState state) => state switch
    {
        ReceiptState.Empty => "No lines",
        ReceiptState.Awaiting => "Awaiting",
        ReceiptState.Partial => "Part received",
        _ => "Complete"
    };

    private static Color ReceiptColor(ReceiptState state) => state switch
    {
        ReceiptState.Empty => Color.Default,
        ReceiptState.Awaiting => Color.Info,
        ReceiptState.Partial => Color.Warning,
        _ => Color.Success
    };
}

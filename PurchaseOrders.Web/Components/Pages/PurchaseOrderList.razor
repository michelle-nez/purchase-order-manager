@page "/purchase-orders"
@using Microsoft.EntityFrameworkCore
@using PurchaseOrders.Data
@using PurchaseOrders.Data.Models
@inject IDbContextFactory<PurchasingDbContext> DbFactory

<PageTitle>Purchase orders - Purchase Order Manager</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between mb-4 gap-3">
    <div>
        <MudText Typo="Typo.h5">Purchase orders</MudText>
        @if (orders is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @orders.Count open @(orders.Count == 1 ? "order" : "orders") ·
                @orders.Sum(o => o.Total).ToString("C") on order
            </MudText>
        }
    </div>
    <MudButton Href="/purchase-orders/new" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.Add">
        New purchase order
    </MudButton>
</div>

@if (orders is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (orders.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center"
              Style="border:1px dashed var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" Class="mt-3">No open purchase orders</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Raise one and add the lines you are buying.
        </MudText>
        <MudButton Href="/purchase-orders/new" Variant="Variant.Filled" Color="Color.Primary">
            New purchase order
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Elevation="0" Style="border:1px solid var(--mud-palette-divider);">
        <MudTable Items="orders" Hover="true" Dense="true" Striped="true"
                  Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh>PO</MudTh>
                <MudTh>Supplier</MudTh>
                <MudTh Style="text-align:right">Lines</MudTh>
                <MudTh Style="text-align:right">Received</MudTh>
                <MudTh Style="text-align:right">Total</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="PO">
                    <MudLink Href="@($"/purchase-orders/{context.Id}")"
                             Style="font-family:Consolas,monospace;font-weight:600;">
                        @context.PoNumber
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Supplier">@context.Supplier?.Name</MudTd>
                <MudTd DataLabel="Lines" Style="text-align:right">@context.Lines.Count</MudTd>
                <MudTd DataLabel="Received" Style="text-align:right">
                    @context.TotalReceived / @context.TotalOrdered
                </MudTd>
                <MudTd DataLabel="Total" Style="text-align:right">@context.Total.ToString("C")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@ReceiptColor(context.Receipt)">
                        @ReceiptLabel(context.Receipt)
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<PurchaseOrder>? orders;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Include the lines as well as the supplier - the totals on this screen are
        // worked out from the lines, so they have to come back with the order.
        orders = await db.PurchaseOrders
            .AsNoTracking()
            .Include(o => o.Supplier)
            .Include(o => o.Lines)
            .Where(o => !o.IsCancelled)
            .OrderByDescending(o => o.OrderedUtc)
            .ToListAsync();
    }

    private static string ReceiptLabel(ReceiptState state) => state switch
    {
        ReceiptState.Empty => "No lines",
        ReceiptState.Awaiting => "Awaiting",
        ReceiptState.Partial => "Part received",
        _ => "Complete"
    };

    private static Color ReceiptColor(ReceiptState state) => state switch
    {
        ReceiptState.Empty => Color.Default,
        ReceiptState.Awaiting => Color.Info,
        ReceiptState.Partial => Color.Warning,
        _ => Color.Success
    };
}

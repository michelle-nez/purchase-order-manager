@page "/"

<PageTitle>Purchase Order Manager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Purchase Order Manager</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-6" Style="max-width:46rem;">
    Raise a purchase order against a supplier, add the lines you are buying, then
    receive stock against those lines as it arrives - including when only part of a
    line turns up.
</MudText>

<MudPaper Elevation="0" Class="pa-6 mb-4" Style="border:1px solid var(--mud-palette-divider);max-width:52rem;">
    <MudText Typo="Typo.h6" Class="mb-3">What it does</MudText>
    <MudList T="string" Dense="true">
        <MudListItem T="string" Icon="@Icons.Material.Outlined.AccountTree">
            Purchase orders and their line items in a real master-detail relationship
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Outlined.Functions">
            Order totals are calculated from the lines, never stored on the order
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Outlined.LocalShipping">
            Partial receipts, with the outstanding quantity tracked per line
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Outlined.Shield">
            Deleting an order takes its lines with it; a supplier in use cannot be deleted
        </MudListItem>
    </MudList>
    <MudButton Href="/purchase-orders" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
               EndIcon="@Icons.Material.Outlined.ArrowForward">
        Open purchase orders
    </MudButton>
</MudPaper>
